# Configuration de Delta en production (docker-compose.prod.yml).
# Copier ce fichier en .env.production sur le serveur, puis le remplir.
# .env.production contient des secrets : il ne doit JAMAIS être commité
# (il est dans .gitignore).

# --- Domaine ---
# Doit déjà pointer vers l'adresse IP du serveur (enregistrement DNS A),
# sinon Caddy ne pourra pas obtenir le certificat HTTPS.
DOMAINE=delta.example.mg

# --- Base de données (conteneur « db ») ---
# Mot de passe : lettres et chiffres seulement (il entre dans une URL).
# Générer : python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_USER=delta
POSTGRES_PASSWORD=a_remplacer
POSTGRES_DB=delta

# --- Sécurité ---
# Clé des sessions. Générer : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# La changer déconnecte tout le monde.
SECRET_KEY=a_remplacer
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Envoi d'e-mails (code de vérification à l'inscription) ---
# Obligatoire en production : sans lui, personne ne peut activer de compte.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_EXPEDITEUR=

# --- Assistant IA (s'allume si les clés sont présentes) ---
AI_ENABLED=
GROQ_API_KEY=
EMBEDDINGS_FOURNISSEUR=jina
JINA_API_KEY=

# --- Annulation automatique des impayés (2 h commandes, 24 h acomptes) ---
# Tant qu'aucun paiement en ligne réel n'est branché, false évite d'annuler
# des commandes qui seront réglées au comptoir (voir docs/deploiement.md).
EXPIRATION_AUTOMATIQUE=false

# --- Pied de page et formations (figés à la construction du site) ---
VITE_FACEBOOK_URL=
VITE_TELEPHONE_FORMATION=

# --- Ports publiés (80 et 443 par défaut, à ne changer que pour un essai) ---
# PORT_HTTP=80
# PORT_HTTPS=443
