# Caddy, devant le site Delta en production (voir docs/deploiement.md).
# {$DOMAINE} vient de .env.production : Caddy y obtient et renouvelle seul
# le certificat HTTPS (Let's Encrypt) et redirige http vers https.
{$DOMAINE} {
	encode zstd gzip

	# L'API, relayée telle quelle au backend : même domaine que le site.
	handle /api/* {
		reverse_proxy backend:8000 {
			# Le flux de l'assistant IA (SSE) part au fil de l'eau.
			flush_interval -1
		}
	}

	# Le site : une application à page unique, toute adresse inconnue
	# retombe sur index.html et c'est React qui affiche la bonne page.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# Fichiers de construction nommés d'après leur contenu : cache long.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# index.html jamais en cache : une mise à jour se voit tout de suite.
		@page not path /assets/*
		header @page Cache-Control "no-cache"
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# Photos téléversées : 5 Mio côté API, un peu de marge ici.
	request_body {
		max_size 10MB
	}
}
