# Copier ce fichier en `.env` et renseigner les valeurs réelles.
# Ne jamais commiter le fichier `.env` (voir .gitignore).

# --- Base de données PostgreSQL ---
# Port 5433 : le conteneur Docker publie sur 5433 pour ne pas entrer en conflit
# avec un éventuel PostgreSQL système sur 5432 (voir docs/architecture.md).
DATABASE_URL=postgresql+psycopg2://delta_user:change_me@localhost:5433/delta

# --- Identifiants du conteneur PostgreSQL (lus par docker-compose.yml) ---
# Doivent rester cohérents avec le DATABASE_URL ci-dessus : c'est la même base.
POSTGRES_USER=delta_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=delta

# --- Sécurité / JWT ---
# Générer une clé forte, ex : python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_me_avec_une_cle_secrete_forte
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- API ---
API_V1_PREFIX=/api/v1
PROJECT_NAME=Delta

# --- CORS (origines autorisées, séparées par des virgules) ---
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Environnement d'exécution ---
# `developpement` ou `production`. Défaut fermé si omis (`production`).
# Contrôle notamment l'accès à POST /paiements/{id}/simuler-confirmation
# (Sprint 9.5, dette technique documentée dans docs/mld.md) : n'y donner
# accès qu'en local/CI, jamais en production.
ENVIRONMENT=developpement

# --- Envoi d'e-mails (code de vérification à l'inscription) ---
# Serveur SMTP : Gmail (smtp.gmail.com, mot de passe d'application),
# Brevo (smtp-relay.brevo.com)… Vide : aucun e-mail ne part, et en
# développement le code s'écrit dans le terminal du serveur.
SMTP_HOST=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_EXPEDITEUR=

# --- Rate limiting (dette technique T0.6) ---
# Backend de stockage du limiteur sur /auth/connexion et
# /auth/personnel/connexion. `memory://` : correct pour un déploiement
# mono-processus/mono-instance (le seul qui existe aujourd'hui). Devient
# incorrect (limite multipliée par le nombre de workers) dès qu'un
# déploiement en scale plusieurs — passer alors à `redis://hôte:port`,
# simple changement de configuration. Voir docs/roadmap.md, Dette technique.
RATE_LIMIT_STORAGE_URI=memory://

# --- Assistant IA générative (Sprint 12) ---
# Dépendances à part : pip install -r requirements-ai.txt
# Automatique si absent ou vide : l'assistant s'allume dès que les deux clés
# ci-dessous sont renseignées. false l'éteint explicitement ; true exige les
# deux clés au démarrage.
AI_ENABLED=
# LLM — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Embeddings — https://huggingface.co/settings/tokens (jeton « Fine-grained »,
# permission « Make calls to Inference Providers » uniquement)
HF_API_TOKEN=
# Changer de modèle impose une réindexation (scripts/reindexer_assistant.py).
LC_EMBEDDING_MODEL=BAAI/bge-m3
# Fournisseur des embeddings : huggingface (HF_API_TOKEN), google
# (GOOGLE_API_KEY) ou jina (JINA_API_KEY, quota gratuit sans carte :
# https://jina.ai/api-dashboard/). En changer impose une réindexation :
#     python -m scripts.reindexer_assistant
EMBEDDINGS_FOURNISSEUR=huggingface
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_EMBEDDING_DIMENSION=768
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIMENSION=1024

# --- Impayés (13 octobre 2026, cf. docs/mld.md) ---
# Annule les commandes non payées après COMMANDE_DELAI_PAIEMENT_MINUTES et
# les réservations sans acompte après RESERVATION_DELAI_ACOMPTE_HEURES.
EXPIRATION_AUTOMATIQUE=true
COMMANDE_DELAI_PAIEMENT_MINUTES=120
RESERVATION_DELAI_ACOMPTE_HEURES=24
ACOMPTE_POURCENTAGE=30
